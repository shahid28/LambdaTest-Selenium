<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SeleniumAdvancedSuite" parallel="tests" thread-count="2">
    <test name="Chrome on Windows">
        <parameter name="browser" value="chrome"  />
        <parameter name="version" value="128.0"/>
        <parameter name="platform" value="Windows 10" />
        <classes>
            <class name="org.lambdatest.selenium.task.SeleniumAdvancedAssignment" />
        </classes>
    </test>
    <test name="Edge on macOS">
        <parameter name="browser" value="edge" />
        <parameter name="version" value="127.0" />
        <parameter name="platform" value="macOS Ventura" />
        <classes>
            <class name="org.lambdatest.selenium.task.SeleniumAdvancedAssignment" />
        </classes>
    </test>
</suite>
